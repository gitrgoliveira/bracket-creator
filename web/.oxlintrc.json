{
  "$schema": "../web-mobile/node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "bootstrap": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error",
    "no-unused-expressions": [
      "error",
      { "allowShortCircuit": true, "allowTernary": true }
    ]
  },
  "ignorePatterns": ["node_modules/**"]
}
